package-as: Groupee

# The addon lives in Groupee/; package its contents as the Groupee folder.
move-folders:
  Groupee/Groupee: Groupee

# Written by the release workflow from Groupee/CHANGELOG.md. It must live outside
# Groupee/: packager v2 loses a changelog path inside a move-folders folder.
manual-changelog:
  filename: RELEASE_NOTES.md
  markup-type: markdown

ignore:
  - assets
  - LICENSE
  - RELEASE_NOTES.md
